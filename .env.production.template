# ==============================================================================
# Knora Public Demo - Production Environment Configuration Template
# ==============================================================================
# Use this template to set environment variables on your deployment platforms:
# - Backend Web Service (Render / Cloud Host): Section 1, 2, 3, 4, 5
# - Frontend Application (Vercel): Section 6
# - Keycloak Service (Render / Cloud Host): Section 5 (KC_* variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (Supabase PostgreSQL with pgvector)
# ------------------------------------------------------------------------------
# In Supabase Project Settings -> Database -> Connection string -> URI (Pooled or Direct):
# Example: postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require
KNORA_DATABASE_URL=postgresql+psycopg://postgres:<SUPABASE_DB_PASSWORD>@<SUPABASE_HOST>:6543/postgres?sslmode=require

# ------------------------------------------------------------------------------
# 2. Object Storage (Cloudflare R2 - S3 Compatible)
# ------------------------------------------------------------------------------
# In Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API Token (Admin or Object Read/Write):
KNORA_OBJECT_STORE_BACKEND=s3_compatible
KNORA_OBJECT_STORE_S3_ENDPOINT=https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
KNORA_OBJECT_STORE_S3_BUCKET=knora-public-demo
KNORA_OBJECT_STORE_S3_REGION=auto
KNORA_OBJECT_STORE_S3_ACCESS_KEY=<R2_ACCESS_KEY_ID>
KNORA_OBJECT_STORE_S3_SECRET_KEY=<R2_SECRET_ACCESS_KEY>

# ------------------------------------------------------------------------------
# 3. Vector & Lexical Search (Qdrant Cloud Free Tier)
# ------------------------------------------------------------------------------
# In Qdrant Cloud Console -> Clusters -> Free Tier 1GB Cluster:
# Example URL: https://xxxx-xxxx.us-east4-0.gcp.cloud.qdrant.io:6333
KNORA_LEXICAL_QDRANT_URL=https://<QDRANT_CLUSTER_ID>.<REGION>.cloud.qdrant.io:6333
KNORA_LEXICAL_QDRANT_COLLECTION=knora
KNORA_LEXICAL_QDRANT_API_KEY=<QDRANT_API_KEY>

# ------------------------------------------------------------------------------
# 4. AI Inference & Embeddings (Cloudflare Workers AI)
# ------------------------------------------------------------------------------
# In Cloudflare Dashboard -> Workers & Pages -> API Tokens -> Create Token (Workers AI Read):
KNORA_EMBEDDING_PROVIDER=cloudflare-workers-ai
KNORA_GENERATION_PROVIDER=cloudflare-workers-ai
KNORA_CLOUDFLARE_ACCOUNT_ID=<CLOUDFLARE_ACCOUNT_ID_32_HEX>
KNORA_CLOUDFLARE_API_TOKEN=<CLOUDFLARE_API_TOKEN>
KNORA_CLOUDFLARE_EMBEDDING_MODEL=@cf/qwen/qwen3-embedding-0.6b
KNORA_CLOUDFLARE_GENERATION_MODEL=@cf/openai/gpt-oss-20b
KNORA_RETRIEVAL_CONFIGURATION_ID=retrieval-hybrid-top8-v3

# ------------------------------------------------------------------------------
# 5. Identity & Access (Keycloak)
# ------------------------------------------------------------------------------
# URL of your Keycloak deployment (e.g. on Render or custom domain)
KNORA_KEYCLOAK_ISSUER=https://<KEYCLOAK_HOST>/realms/knora-dev
KNORA_KEYCLOAK_AUDIENCE=knora-web
KNORA_KEYCLOAK_JWKS_URL=https://<KEYCLOAK_HOST>/realms/knora-dev/protocol/openid-connect/certs
KNORA_KEYCLOAK_JWKS_CACHE_TTL_SECONDS=300

# Variables specifically for running the Keycloak service container:
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# KC_BOOTSTRAP_ADMIN_PASSWORD=<STRONG_ADMIN_PASSWORD>
# KC_DB=postgres
# KC_DB_URL=jdbc:postgresql://<SUPABASE_HOST>:5432/postgres?sslmode=require
# KC_DB_USERNAME=postgres
# KC_DB_PASSWORD=<SUPABASE_DB_PASSWORD>
# KC_HOSTNAME=https://<KEYCLOAK_HOST>

# ------------------------------------------------------------------------------
# 6. Frontend Environment Variables (Configure in Vercel Project Settings)
# ------------------------------------------------------------------------------
# KNORA_API_URL=https://<RENDER_BACKEND_HOST>
# KEYCLOAK_AUTHORIZATION_URL=https://<KEYCLOAK_HOST>/realms/knora-dev/protocol/openid-connect/auth
# KEYCLOAK_TOKEN_URL=https://<KEYCLOAK_HOST>/realms/knora-dev/protocol/openid-connect/token
# KEYCLOAK_REDIRECT_URI=https://<VERCEL_APP_DOMAIN>/api/auth/callback
# KEYCLOAK_POST_LOGOUT_REDIRECT_URI=https://<VERCEL_APP_DOMAIN>/
# KEYCLOAK_ISSUER=https://<KEYCLOAK_HOST>/realms/knora-dev
# KEYCLOAK_JWKS_URL=https://<KEYCLOAK_HOST>/realms/knora-dev/protocol/openid-connect/certs
# KEYCLOAK_CLIENT_ID=knora-web
# KEYCLOAK_AUDIENCE=knora-web
# SESSION_SECRET=<GENERATE_RANDOM_32_CHAR_STRING>
