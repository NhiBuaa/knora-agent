KNORA_DATABASE_URL=postgresql+psycopg://knora:knora@localhost:5432/knora
KNORA_OBJECT_STORE_ROOT=.knora-objects
KNORA_OBJECT_STORE_BACKEND=filesystem
KNORA_OBJECT_STORE_S3_ENDPOINT=http://localhost:9000
KNORA_OBJECT_STORE_S3_BUCKET=knora
KNORA_OBJECT_STORE_S3_REGION=us-east-1
KNORA_OBJECT_STORE_S3_ACCESS_KEY=
KNORA_OBJECT_STORE_S3_SECRET_KEY=
# Compose storage credentials are supplied only at runtime. Keep all values blank in tracked files.
KNORA_CANONICAL_MINIO_ACCESS_KEY=
KNORA_CANONICAL_MINIO_SECRET_KEY=
KNORA_PROVIDER_TEST_ACCESS_KEY=
KNORA_PROVIDER_TEST_SECRET_KEY=
KNORA_OBJECT_INVENTORY_MANIFEST=
KNORA_OBJECT_INVENTORY_MINIMUM_AGE_SECONDS=86400
KNORA_OPERATIONAL_ALERT_CONFIGURATION_JSON=
KNORA_OPERATIONAL_METRICS_RETRY_WINDOW_SECONDS=300
KNORA_EMBEDDING_DIMENSION=1536
KNORA_API_CREDENTIALS_JSON=[]
KNORA_PROVIDER_MODE=deterministic-local

# Production Retrieval V2 native Gemini embedding. Keep the key blank in tracked files.
KNORA_GEMINI_API_KEY=
KNORA_GEMINI_TIMEOUT_SECONDS=60

# Required only when KNORA_PROVIDER_MODE=openai-compatible. Keep the key blank in tracked files.
KNORA_OPENAI_BASE_URL=https://api.openai.com/v1
KNORA_OPENAI_API_KEY=
KNORA_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
KNORA_OPENAI_EMBEDDING_CONFIGURATION_ID=embedding-openai-m1-v1
KNORA_OPENAI_GENERATION_MODEL=
KNORA_OPENAI_PRICING_VERSION=
KNORA_OPENAI_EMBEDDING_INPUT_COST_PER_MILLION_TOKENS=
KNORA_OPENAI_GENERATION_INPUT_COST_PER_MILLION_TOKENS=
KNORA_OPENAI_GENERATION_OUTPUT_COST_PER_MILLION_TOKENS=
KNORA_OPENAI_TIMEOUT_SECONDS=60

# Required only for --mode model-backed in the evaluation runner. Keep scorer secrets blank in tracked files.
KNORA_SEMANTIC_SCORER_BASE_URL=https://api.openai.com/v1
KNORA_SEMANTIC_SCORER_API_KEY=
KNORA_SEMANTIC_SCORER_MODEL=
KNORA_SEMANTIC_SCORER_TIMEOUT_SECONDS=60
KNORA_SEMANTIC_SCORER_PRICING_VERSION=
KNORA_SEMANTIC_SCORER_INPUT_COST_PER_MILLION_TOKENS=
KNORA_SEMANTIC_SCORER_OUTPUT_COST_PER_MILLION_TOKENS=
