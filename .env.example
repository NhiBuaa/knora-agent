# Sao chép thành .env để chạy hằng ngày bằng .\scripts\start-dev.ps1.
# .env được Git bỏ qua; chỉ lưu secret thật tại đó hoặc trong môi trường process.
# Không ghi credential vào Git, log hoặc biến NEXT_PUBLIC_.

# 1. CẦN ĐIỀN: AI thật + lưu trữ + phiên đăng nhập.
# Account ID gồm 32 ký tự hex; token cần quyền Workers AI.
KNORA_CLOUDFLARE_ACCOUNT_ID=
KNORA_CLOUDFLARE_API_TOKEN=
# Tự chọn credential MinIO local; nếu dùng storage cũ, giữ credential đang có.
KNORA_OBJECT_STORE_S3_ACCESS_KEY=
KNORA_OBJECT_STORE_S3_SECRET_KEY=
# Tạo chuỗi ngẫu nhiên bằng lệnh trong docs/runbooks/local-development.md#one-time-setup.
SESSION_SECRET=

# 2. CẦN ĐIỀN: quên mật khẩu qua email OTP thuộc daily dev.
# Chỉ cho local: mẫu bật rõ nguồn key từ .env; production giữ công tắc này tắt.
KNORA_OTP_LOCAL_DEV_ENABLED=true
# Tạo Base64 từ ít nhất 32 byte ngẫu nhiên; xem hướng dẫn setup bên dưới.
# Nếu đã có runtime, giữ nguyên HMAC key đang dùng qua các lần khởi động.
KNORA_OTP_HMAC_KEY=
# Gmail: FROM là địa chỉ gửi được phép, USER là tài khoản Gmail gửi thư.
# Thường FROM và USER giống nhau; nhập cùng địa chỉ vào cả hai dòng.
KC_SMTP_FROM=
KC_SMTP_USER=
# Dùng App Password của Google, không dùng mật khẩu đăng nhập Gmail.
KC_SMTP_PASSWORD=
# Các giá trị Gmail điền sẵn, không cần sửa.
KC_SMTP_HOST=smtp.gmail.com
KC_SMTP_PORT=587
KC_SMTP_STARTTLS=true
KC_SMTP_AUTH=true
# Điền .env chưa tự cấu hình SMTP/reset flow trong realm Keycloak.
# Làm setup một lần theo docs/runbooks/local-development.md#daily-auth-setup-one-time.
# Sau setup, chạy hằng ngày bằng .\scripts\start-dev.ps1.

# 3. CÓ DEFAULT: không cần thêm các biến dưới đây để chạy daily development.
# start-dev chọn Cloudflare cho cả embedding/generation; backend trực tiếp/CI
# vẫn dùng deterministic-local (không gọi AI thật). Ollama là tùy chọn offline.
# Retrieval vẫn mặc định retrieval-m1-v1; không tự đổi policy hoặc embedding profile.

# 4. LAUNCHER TỰ ĐIỀN: không nhập dimension/profile pin/model digest, database URL,
# API origin hoặc OIDC của realm knora-dev đi kèm. MinIO dùng cặp credential ở trên.
# Tham số launcher ưu tiên hơn process env; process env ưu tiên hơn .env.
# Khởi động lại launcher sau khi sửa .env; không đổi runtime của session khác.

# 5. CHẾ ĐỘ RIÊNG: chỉ thêm biến khi cần; xem recipe, tên biến và default tại
# docs/runbooks/local-development.md#configuration-reference.
# - Ollama offline, mô phỏng deterministic, OIDC ngoài, backend/CLI trực tiếp,
#   storage giữ lại, Compose/provider-test và operations: xem hướng dẫn trên.
# - Gemini/OpenAI-compatible và semantic scorer vẫn được hỗ trợ riêng:
#   docs/evaluation.md#provider-and-scorer-configuration.
#   Scorer đọc process env; chỉ điền .env không tự cấp cấu hình cho evaluator.
# Không bỏ trống biến số tùy chọn bằng TEN_BIEN=; hãy để biến đó chưa được đặt.
