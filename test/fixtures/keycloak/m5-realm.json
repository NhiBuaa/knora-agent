{
  "realm": "m5-e2e",
  "enabled": true,
  "displayName": "Knora M5 E2E (test only)",
  "registrationAllowed": false,
  "verifyEmail": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "clients": [
    {
      "clientId": "knora-web",
      "name": "Knora Web M5 E2E (test only)",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://127.0.0.1:3000/api/auth/callback"],
      "webOrigins": ["http://127.0.0.1:3000"],
      "attributes": {
        "post.logout.redirect.uris": "http://127.0.0.1:3000/"
      },
      "protocolMappers": [
        {
          "name": "workspace_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "workspace_id",
            "claim.name": "workspace_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "workspace_ids",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "workspace_ids",
            "claim.name": "workspace_ids",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "capabilities",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "capabilities",
            "claim.name": "capabilities",
            "jsonType.label": "JSON",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "operator",
        "description": "M5 E2E operator role (test only)",
        "composite": false,
        "clientRole": false
      }
    ]
  },
  "users": [
    {
      "username": "m5-user",
      "email": "m5-user@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "workspace_id": ["m5-workspace"],
        "workspace_ids": ["m5-workspace"],
        "capabilities": ["documents:write", "questions:ask"]
      },
      "credentials": [{"type": "password", "value": "m5-user-password", "temporary": false}]
    },
    {
      "username": "m5-operator",
      "email": "m5-operator@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "workspace_id": ["m5-workspace"],
        "workspace_ids": ["m5-workspace"],
        "capabilities": ["documents:write", "questions:ask", "operator:read"]
      },
      "realmRoles": ["operator"],
      "credentials": [{"type": "password", "value": "m5-operator-password", "temporary": false}]
    },
    {
      "username": "m5-other-workspace",
      "email": "m5-other-workspace@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "workspace_id": ["m5-other-workspace"],
        "workspace_ids": ["m5-other-workspace"],
        "capabilities": ["documents:write", "questions:ask"]
      },
      "credentials": [{"type": "password", "value": "m5-other-workspace-password", "temporary": false}]
    },
    {
      "username": "m5-no-operator",
      "email": "m5-no-operator@example.test",
      "enabled": true,
      "emailVerified": true,
      "attributes": {
        "workspace_id": ["m5-workspace"],
        "workspace_ids": ["m5-workspace"],
        "capabilities": ["documents:write", "questions:ask"]
      },
      "credentials": [{"type": "password", "value": "m5-no-operator-password", "temporary": false}]
    }
  ]
}
